grammar nl.esi.comma.testspecification.Testspecification with nl.esi.comma.assertthat.AssertThat

generate testspecification "http://www.esi.nl/comma/testspecification/Testspecification"
import "http://www.esi.nl/xtext/common/lang/Base" as base
import "http://www.esi.nl/xtext/types/Types" as types
import "http://www.esi.nl/xtext/expressions/Expression" as expr

TSMain returns base::ModelContainer:
    {TSMain}
    imports+=Import*
    namespace+=NameSpace*
    model=TestDefinition;

@Override
NamedElement returns base::NamedElement:
    name=QualifiedName | Variable;

TestDefinition:
    {TestDefinition}
    ('Test-Purpose' purpose=STRING)?
    ('Background' background=STRING)?
    ('Stakeholders' stakeholder+=StakeHolder+)?
    testSeq+=TestSequence*
    stepSeq+=StepSequence*
    'generate-file' filePath=STRING
    ('global-parameters' gparams+=Variable+)?
    ('step-parameters' stepparams+=Variable+)?
    ('global-param-init' gparamsInitActions+=(AssignmentAction | RecordFieldAssignmentAction)+)?;

StakeHolder:
    'stakeholder-name' name=STRING
    'function' function=STRING
    'comments' comments=STRING;

TestSequence:
    'test-sequence' name=ID '{'
    stepSeqRef+=[StepSequence|ID]+
    '}';

StepSequence:
    'step-sequence' name=ID '{'
    step+=AbstractStep*
    '}';

AbstractStep:
    AssertionStep | RunStep;

AssertionStep:
    stepVar=AssertionStepVariable
    'assertion-items' '{' asserts+=DataAssertions* '}'
    ('assertion-context' context += RecordFieldAssignmentAction*)?
    ('assertion-input' input += RecordFieldAssignmentAction*)?
    ('assertion-sut' sut += RecordFieldAssignmentAction*)?
;

AssertionStepVariable returns expr::Variable:
    'assertion-id' name=ID
    'assertion-type' type=Type;

RunStep:
    stepVar=RunStepVariable
    ('step-context' context += RecordFieldAssignmentAction*)?
    ('step-input' input += RecordFieldAssignmentAction*)?
    ('step-sut' sut += RecordFieldAssignmentAction*)?
;

RunStepVariable returns expr::Variable:
    'step-id' name=ID
    'step-type' type=Type
;
