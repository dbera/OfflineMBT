Project bpmn4s2pspec {
	Generate Simulator {
		fries_comp {
			bpmn-file "input/fries_comp.bpmn"
		}
	}
	Generate Simulator {
		fries_flat {
			bpmn-file "input/fries_flat.bpmn"
		}
	}
	Generate Simulator {
		fries_sub {
			bpmn-file "input/fries_sub.bpmn"
		}
	}
	Generate Simulator {
		imaging {
			bpmn-file "input/imaging.bpmn"
		}
	}
	Generate Simulator {
		printer_prio {
			bpmn-file "input/printer_prio.bpmn"
		}
	}
	Generate Simulator {
		printer {
			bpmn-file "input/printer.bpmn"
		}
	}
}