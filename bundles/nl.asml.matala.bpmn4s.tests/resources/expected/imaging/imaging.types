record UNIT {
	int	unit
}

record ImgReq {
  ImageEnum cmd_type
  int id
  ImageQuality image_quality
}

record PumpResp {
  ResponseEnum result
}

enum Status {
  ON
  OFF
  PREPARING
  UNPREPARING
}

enum ResponseEnum {
  OK
  NOK
}

record ImgResp {
  ResponseEnum result
}

record AcqResp {
  ResponseEnum result
  int id
}

record AcqData {
  int id
  @symbolic real contrast
  @symbolic real resolution
  @symbolic real signal_to_noise_ratio
}

@context
record CTX {
  int id
}

record PumpReq {
  VacuumEnum cmd_type
  int id
}

record EquipmentStatus {
  Status temp_status
  Status pump_status
  Status acq_status
}

record TempReq {
  TempEnum cmd_type
  int id
}

record TempResp {
  ResponseEnum result
  @symbolic int temp_val
  int reqid
}

enum ImageEnum {
  PREPARE
  START
  STOP
  UNPREPARE
}

enum TempEnum {
  SET
  RESET
}

enum ImageQuality {
  HIGH
  LOW
  NA
}

enum VacuumEnum {
  ON
  OFF
}

record VacResp {
  ResponseEnum result
}

record VacReq {
  VacuumEnum cmd_type
  int id
}

record AcqReq {
  ImageEnum cmd_type
  int id
}