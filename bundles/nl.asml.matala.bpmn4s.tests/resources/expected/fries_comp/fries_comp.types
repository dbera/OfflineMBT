record UNIT {
	int	unit
}

record Fries {
  Size size
  Topping[] style
}

record FriesOrder {
  string client_id
  Fries fries
}

record Receipt {
  real amount
}

@context
record ClientContext {
  string client_id
  Fries fries
  bool premium
}

@context
record DeliveryServiceContext {
  FriesDelivery delivery
}

enum Topping {
  Ketchup
  Mayo
  Onions
}

record FriesDelivery {
  FriesOrder clientOrder
  Receipt receipt
}

enum Size {
  Small
  Medium
  Large
  Undefined
}

@context
record SnackbarContext {
  string employee_id
  int orders
}