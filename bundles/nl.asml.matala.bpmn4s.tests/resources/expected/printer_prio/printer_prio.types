@context
record UNIT {
	@suppress int	unit
}

record OptimizeRequest {
  int id
}

enum OperationType {
  PREP
  PRINT
}

enum PrintResolution {
  LOW
  MED
  HIGH
}

record AssertionsHistory {
  int[] inspectionReports
}

record MeasureRequest {
  int id
  @mixed Report printJobReport
}

record CorrectionItem {
  string data
}

record Result {
  Outcome verdict
}

enum ColorType {
  MONOCHROME
  COLOR
}

record CorrectionsReport {
  @mixed map<int, CorrectionItem[]> correctionsMap
  int id
}

@context
record FactoryCtx {
  int id
  PrintResolution resolution
  real scale
  ColorType color
}

enum Outcome {
  OK
  NOK
}

record Report {
  int id
  @symbolic string payload
  @symbolic real kpi
}

record PrintRequest {
  int id
  PrintResolution resolution
  real scale
  ColorType color
  OperationType opType
}