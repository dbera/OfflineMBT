step-id    step_SupervisonModelAcquisitionController_StopAcquisition_default_0
step-type  ExecAcquisitionCommand
step-input
    step_SupervisonModelAcquisitionController_StopAcquisition_default_0.input.AcquisitionReq.cmd_type := ImageEnum::STOP
    step_SupervisonModelAcquisitionController_StopAcquisition_default_0.input.AcquisitionReq.id := 2

step-id    step_SupervisonModelAcquisitionController_Execacquisitioninitandteardown_default_1
step-type  ExecAcquisitionCommand
step-input
    step_SupervisonModelAcquisitionController_Execacquisitioninitandteardown_default_1.input.AcquisitionReq.cmd_type := ImageEnum::UNPREPARE
