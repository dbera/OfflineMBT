assertion-id    step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0
assertion-type  CheckAcquisitionResult
assertion-items {
    assertions default {
        IQ1 : assert-that (step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.contrast) {
        close-to 0.5
        }
        IQ2 : assert-that (step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.resolution) {
        close-to 512
        }
        IQ3 : assert-that (step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.signal_to_noise_ratio) {
        close-to 0.55
        }
    }
}
assertion-input
    step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.contrast := step_SupervisonModelAcquisitionController_StopAcquisition_default_0.output.ImageData.contrast
    step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.id := 2
    step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.resolution := step_SupervisonModelAcquisitionController_StopAcquisition_default_0.output.ImageData.resolution
    step_SupervisonModelSupervisionImaging_CheckLowResImageQuality_default_0.input.ImageData.signal_to_noise_ratio := step_SupervisonModelAcquisitionController_StopAcquisition_default_0.output.ImageData.signal_to_noise_ratio
