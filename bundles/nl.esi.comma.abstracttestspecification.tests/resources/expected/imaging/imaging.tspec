import "imaging.types"

test-sequence from_abstract_to_concrete {
    test_single_sequence
}

step-sequence test_single_sequence {
step-id    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0
step-type  SetTemperature
step-context
    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.input.EqStatus.acq_status := Status::OFF
    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.input.EqStatus.pump_status := Status::OFF
    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.input.EqStatus.temp_status := Status::OFF
step-input
    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.input.TempCMD.cmd_type := TempEnum::SET
    step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.input.TempCMD.id := 0

assertion-id    step_SupervisonModelTemperatureController_CheckTemp_default_0
assertion-type  TempCheck
assertion-items {
    assertions default {
        x: assert-that(step_SupervisonModelTemperatureController_CheckTemp_default_0.input.temp_achieved.temp_val){equal-to 1}
    }
}
assertion-context
    step_SupervisonModelTemperatureController_CheckTemp_default_0.input.temp_ctx.id := 1
assertion-input
    step_SupervisonModelTemperatureController_CheckTemp_default_0.input.temp_achieved.reqid := 0
    step_SupervisonModelTemperatureController_CheckTemp_default_0.input.temp_achieved.result := ResponseEnum::OK
    step_SupervisonModelTemperatureController_CheckTemp_default_0.input.temp_achieved.temp_val := step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.output.temp_achieved.temp_val
    step_SupervisonModelTemperatureController_CheckTemp_default_0.input.TempUpdate.temp_val := step_SupervisonModelSupervisionTemperatureHandler_ExecuteSetTemp_default_0.output.TempUpdate.temp_val

step-id    step_SupervisonModelAcquisitionController_Execacquisitioninitandteardown_default_0
step-type  ExecAcquisitionCommand
step-input
    step_SupervisonModelAcquisitionController_Execacquisitioninitandteardown_default_0.input.AcquisitionReq.cmd_type := ImageEnum::PREPARE
    step_SupervisonModelAcquisitionController_Execacquisitioninitandteardown_default_0.input.AcquisitionReq.id := 0

step-id    step_SupervisonModelPumpController_startpump_default_0
step-type  ExecPumpCommand
step-input
