import "issue379.types"

test-sequence from_abstract_to_concrete {
    test_single_sequence
}

step-sequence test_single_sequence {
step-id    step_Root_Run_default_0
step-type  RUN
step-context
    step_Root_Run_default_0.input.ctx.id := 0
    step_Root_Run_default_0.input.ctx.nested.mix := "My Init Value"
    step_Root_Run_default_0.input.ctx.nested.symbol := "My Init Symbol"
step-input
    step_Root_Run_default_0.input.data.id := 0
    step_Root_Run_default_0.input.data.id := 1
    step_Root_Run_default_0.input.data.nested := Nested{mix="My R2 Value",symbol="My R2 Symbol"}
    step_Root_Run_default_0.input.data.nested.mix := "My Concrete Value"
    step_Root_Run_default_0.input.data.nested.symbol := "My Concrete Symbol"
    step_Root_Run_default_0.input.data.nested.symbol := "My R3 Symbol"
    step_Root_Run_default_0.input.data.nested.symbol := "My R4 Symbol"
}

generate-file "./dataset/"
