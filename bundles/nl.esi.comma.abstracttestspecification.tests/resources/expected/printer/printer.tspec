import "printer.types"

test-sequence from_abstract_to_concrete {
    test_single_sequence
}

step-sequence test_single_sequence {
step-id    step_PrintFactoryA3DPrinter_RunPrintJob_default_0
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.request.color := ColorType::MONOCHROME
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.request.id := 1
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.request.opType := OperationType::PRINT
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.request.resolution := PrintResolution::LOW
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.request.scale := 50.0
step-sut
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.variants.release := "1.0.0"
    step_PrintFactoryA3DPrinter_RunPrintJob_default_0.input.variants.version := "PX210"

step-id    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.request.color := ColorType::MONOCHROME
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.request.id := 1
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.request.opType := OperationType::PREP
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.request.resolution := PrintResolution::LOW
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.request.scale := null
step-sut
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.variants.release := "1.1.0"
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_0.input.variants.version := "PX210"

step-id    step_PrintFactoryInspection_RunVisualinspection_default_0
step-type  ExecuteInspection
step-input
    step_PrintFactoryInspection_RunVisualinspection_default_0.input.measureRequest.id := 1
    step_PrintFactoryInspection_RunVisualinspection_default_0.input.measureRequest.printJobReport := step_PrintFactoryA3DPrinter_RunPrintJob_default_0.output.printReport

assertion-id    step_PrintFactoryAssertions_AssertVisualInspection_default_0
assertion-type  Assertions
assertion-items {
    assertions default {
        assert_kpi: assert-that (step_PrintFactoryAssertions_AssertVisualInspection_default_0.input.inspectionReport.kpi) {
          equal-to 9.0 within-margin relative (1.0)
        }
    }
}
assertion-context
    step_PrintFactoryAssertions_AssertVisualInspection_default_0.input.history.inspectionReports := <int[]>[
    ]
assertion-input
    step_PrintFactoryAssertions_AssertVisualInspection_default_0.input.inspectionReport.kpi := step_PrintFactoryInspection_RunVisualinspection_default_0.output.inspectionReport.kpi
    step_PrintFactoryAssertions_AssertVisualInspection_default_0.input.inspectionReport.payload := step_PrintFactoryInspection_RunVisualinspection_default_0.output.inspectionReport.payload

step-id    step_PrintFactoryOptimization_RunOptimizationJob_default_0
step-type  ExecuteOptimizer
step-input
    step_PrintFactoryOptimization_RunOptimizationJob_default_0.input.optimizeJob.id := 1

step-id    step_PrintFactoryA3DPrinter_RunPrintJob_default_1
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.request.color := ColorType::COLOR
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.request.id := 2
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.request.opType := OperationType::PRINT
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.request.resolution := PrintResolution::MED
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.request.scale := 75.0
step-sut
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.variants.release := "1.0.0"
    step_PrintFactoryA3DPrinter_RunPrintJob_default_1.input.variants.version := "PX210"

step-id    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.request.color := ColorType::COLOR
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.request.id := 2
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.request.opType := OperationType::PREP
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.request.resolution := PrintResolution::MED
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.request.scale := null
step-sut
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.variants.release := "1.1.0"
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_1.input.variants.version := "PX210"

step-id    step_PrintFactoryInspection_RunVisualinspection_default_1
step-type  ExecuteInspection
step-input
    step_PrintFactoryInspection_RunVisualinspection_default_1.input.measureRequest.id := 2
    step_PrintFactoryInspection_RunVisualinspection_default_1.input.measureRequest.printJobReport := step_PrintFactoryA3DPrinter_RunPrintJob_default_1.output.printReport

assertion-id    step_PrintFactoryAssertions_AssertVisualInspection_default_1
assertion-type  Assertions
assertion-items {
    assertions default {
        assert_kpi: assert-that (step_PrintFactoryAssertions_AssertVisualInspection_default_1.input.inspectionReport.kpi) {
          equal-to 9.0 within-margin relative (1.0)
        }
    }
}
assertion-input
    step_PrintFactoryAssertions_AssertVisualInspection_default_1.input.history.inspectionReports := <int[]>[
        1
    ]
    step_PrintFactoryAssertions_AssertVisualInspection_default_1.input.inspectionReport.kpi := step_PrintFactoryInspection_RunVisualinspection_default_1.output.inspectionReport.kpi
    step_PrintFactoryAssertions_AssertVisualInspection_default_1.input.inspectionReport.payload := step_PrintFactoryInspection_RunVisualinspection_default_1.output.inspectionReport.payload

step-id    step_PrintFactoryOptimization_RunOptimizationJob_default_1
step-type  ExecuteOptimizer
step-input
    step_PrintFactoryOptimization_RunOptimizationJob_default_1.input.optimizeJob.id := 2

step-id    step_PrintFactoryA3DPrinter_RunPrintJob_default_2
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.request.color := ColorType::COLOR
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.request.id := 3
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.request.opType := OperationType::PRINT
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.request.resolution := PrintResolution::HIGH
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.request.scale := 75.0
step-sut
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.variants.release := "2.1.0"
    step_PrintFactoryA3DPrinter_RunPrintJob_default_2.input.variants.version := "TX500"

step-id    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2
step-type  ExecutePrinter
step-input
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.request.color := ColorType::COLOR
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.request.id := 3
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.request.opType := OperationType::PREP
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.request.resolution := PrintResolution::HIGH
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.request.scale := null
step-sut
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.variants.release := "2.1.0"
    step_PrintFactoryA3DPrinter_RunPrepareJob_default_2.input.variants.version := "TX500"

step-id    step_PrintFactoryInspection_RunVisualinspection_default_2
step-type  ExecuteInspection
step-input
    step_PrintFactoryInspection_RunVisualinspection_default_2.input.measureRequest.id := 3
    step_PrintFactoryInspection_RunVisualinspection_default_2.input.measureRequest.printJobReport := step_PrintFactoryA3DPrinter_RunPrintJob_default_2.output.printReport

assertion-id    step_PrintFactoryAssertions_AssertVisualInspection_default_2
assertion-type  Assertions
assertion-items {
    assertions default {
        assert_kpi: assert-that (step_PrintFactoryAssertions_AssertVisualInspection_default_2.input.inspectionReport.kpi) {
          equal-to 9.0 within-margin relative (1.0)
        }
    }
}
assertion-input
    step_PrintFactoryAssertions_AssertVisualInspection_default_2.input.history.inspectionReports := <int[]>[
        1,2
    ]
    step_PrintFactoryAssertions_AssertVisualInspection_default_2.input.inspectionReport.kpi := step_PrintFactoryInspection_RunVisualinspection_default_2.output.inspectionReport.kpi
    step_PrintFactoryAssertions_AssertVisualInspection_default_2.input.inspectionReport.payload := step_PrintFactoryInspection_RunVisualinspection_default_2.output.inspectionReport.payload

step-id    step_PrintFactoryOptimization_RunOptimizationJob_default_2
step-type  ExecuteOptimizer
step-input
    step_PrintFactoryOptimization_RunOptimizationJob_default_2.input.optimizeJob.id := 3
}

generate-file "./dataset/"
