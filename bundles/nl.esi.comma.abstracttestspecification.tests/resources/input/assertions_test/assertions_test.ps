        TestContext	Event_0utv02f
        TestContext	Flow_191w3xb
        TestContext	Flow_03p9ysp
        TestContext	Flow_1j45oji
    
        init
        Event_0f3gr38 := TestContext {
         id = "Test 4",
         hidden = 0
        }
    
    
        desc "AssertionsTestTest 4_Model"
        
        action			Assert42
        element-label	"Assert 4:2"
        case			default priority 4 step-type "Assert_4_2" action-type ASSERT
        with-inputs		Flow_191w3xb, params_4_3
        assertions default {
            report_id: assert-that (params_4_3.id) {
              equal-to 4
            }
        }
        produces-outputs	Flow_03p9ysp
        updates:
            Flow_03p9ysp := Flow_191w3xb
        produces-outputs	params_4_3
        updates:
            params_4_3 := params_4_3
        
        action			Run43
        element-label	"Run 4:3"
        case			default priority 4 step-type "Run_4_3" action-type RUN
        with-inputs		Flow_03p9ysp, params_4_3
        produces-outputs	Flow_1j45oji
        updates:
            Flow_1j45oji := Flow_03p9ysp
        produces-outputs	report_4_3 symbolic-link
        updates:
            report_4_3 := Report { id = params_4_3.id }
        
        action			Compose41
        element-label	"Compose 4:1"
        case			default priority 4 step-type "null" action-type COMPOSE
        with-inputs		Event_0f3gr38
        with-guard		true
        produces-outputs	Flow_191w3xb
        updates:
            Flow_191w3xb := Event_0f3gr38
        produces-outputs	params_4_3 symbolic-link
        updates:
            params_4_3 := ConcreteParams {
             id = 4,
             param = "4_3"
            }
        produces-outputs	params_4_4 symbolic-link suppress
        updates:
            params_4_4 := ConcreteParams {
             id = 4,
             param = "4_4"
            }
        
        action			Assert44
        element-label	"Assert 4:4"
        case			default priority 4 step-type "Assert_4_4" action-type ASSERT
        with-inputs		Flow_1j45oji, params_4_4, report_4_3
        assertions default {
            report_result: assert-that (report_4_3.result) {
              match-regex "\\w+"
            }
        }
        produces-outputs	Event_0utv02f
        updates:
            Event_0utv02f := Flow_1j45oji
    
        element-labels ["AssertionsTest", "Test 4"]
    }
    
