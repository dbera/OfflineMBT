import "assertions_test.types"
specification assertions_test
{
    system AssertionsTestTest1Assert2
    {
        inputs
        Report	report_1_1_2
        
        // outputs
    
        // local
    
        context
        UNIT	Event_0kl62m8
    
        // init
    
    
        desc "AssertionsTestTest 1Assert 2_Model"
        
        action			Assert121
        element-label	"Assert 1:2:1"
        case			default priority 100 step-type "Assert_1_2_1" action-type ASSERT
        with-inputs		report_1_1_2
        assertions default {
            report_id: assert-that (report_1_1_2.id) {
              equal-to 1
            }
            report_result: assert-that (report_1_1_2.result) {
              match-regex "\\w+"
            }
        }
        produces-outputs	Event_0kl62m8
    
        element-labels ["AssertionsTest", "Test 1", "Assert 2"]
    }
    
    system AssertionsTestTest2Run3
    {
        inputs
        SymbolicParams	params_2_3_1
        
        // outputs
    
        // local
    
        context
        UNIT	Event_07uzt4k
    
        // init
    
    
        desc "AssertionsTestTest 2Run 3_Model"
        
        action			Run231
        element-label	"Run 2:3:1"
        case			default priority 100 step-type "Run_2_3_1" action-type RUN
        with-inputs		params_2_3_1
        produces-outputs	Event_07uzt4k
    
        element-labels ["AssertionsTest", "Test 2", "Run 3"]
    }
    
    system AssertionsTestTest7Run1
    {
        inputs
        Variant	variants
        
        outputs
        Variant	variants
    
        local
        ConcreteParams	extContext
        ConcreteParams	params_7_2
    
        context ctx
        TestContext	Event_0yxeb2y
        TestContext	Event_1y5r7sr
        TestContext	Flow_1kfq18j
    
        init
        Event_0yxeb2y := TestContext {
         id = "7",
         hidden = 0
        }
        extContext := ConcreteParams {
         id = 100,
         param = "Extra Context"
        }
        variants := Variant {
         id = 7,
         param = "SUT_7"
        }
        variants := Variant {
         id = 8,
         param = "SUT_8"
        }
    
        suts variants
    
        desc "AssertionsTestTest 7Run 1_Model"
        
        action			Compose71
        element-label	"Compose 7:1"
        case			default priority 7 step-type "null" action-type COMPOSE
        with-inputs		Event_0yxeb2y
        with-guard		true
        produces-outputs	Flow_1kfq18j
        updates:
            Flow_1kfq18j := Event_0yxeb2y
        produces-outputs	params_7_2 symbolic-link
        updates:
            params_7_2 := ConcreteParams {
             id = 7,
             param = "7_2"
            }
        
        action			Run72
        element-label	"Run 7:2"
        case			default priority 7 step-type "Run_7_2" action-type RUN
        with-inputs		Flow_1kfq18j, variants, params_7_2, extContext
        with-guard		toString(variants.id) == Flow_1kfq18j.id
        produces-outputs	Event_1y5r7sr
        updates:
            Event_1y5r7sr := Flow_1kfq18j
        produces-outputs	variants
        updates:
            variants := variants
    
        element-labels ["AssertionsTest", "Test 7", "Run 1"]
    }
    
    system AssertionsTestTest4
    {
        // inputs
        
        // outputs
    
        local
        ConcreteParams	params_4_4
        ConcreteParams	params_4_3
