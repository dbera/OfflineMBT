    system AssertionsTestTest6Assert2
    {
        inputs
        ConcreteParams	params_6_3_1
        
        outputs
        ConcreteParams	params_6_3_1
    
        local
        History	history
    
        context
        UNIT	Event_1mb8mjz
    
        init
        history := History { ids = <string[]>[] }
    
    
        desc "AssertionsTestTest 6Assert 2_Model"
        
        action			Assert621
        element-label	"Assert 6:2:1"
        case			default priority 100 step-type "Assert_6_2_1" action-type ASSERT
        with-inputs		params_6_3_1, history
        with-guard		not contains(history.ids, params_6_3_1.param)
        assertions default {
            id: assert-that(params_6_3_1.id) {
              equal-to 6
            }
        }
        produces-outputs	Event_1mb8mjz
        produces-outputs	history symbolic-link suppress
        updates:
            history := History { 
              ids = add(history.ids, params_6_3_1.param)
            }
        produces-outputs	params_6_3_1
        updates:
            params_6_3_1 := params_6_3_1
    
        element-labels ["AssertionsTest", "Test 6", "Assert 2"]
    }
    
