        }
    
    
        desc "AssertionsTestTest 8_Model"
        
        action			Assert84
        element-label	"Assert 8:4"
        case			default priority 8 step-type "Assert_8_4" action-type ASSERT
        with-inputs		Flow_0gq62tt, report_8_1, report_8_3
        assertions default {
            result: assert-that (report_8_1.result) {
              equal-to report_8_3.result
            }
        }
        produces-outputs	Event_16siryv
        updates:
            Event_16siryv := Flow_0gq62tt
        
        action			Run81
        element-label	"Run 8:1"
