            result: assert-that (report_8_1.result) {
              equal-to "Test 8"
            }
        }
        produces-outputs	Flow_1qde61m
        updates:
            Flow_1qde61m := Flow_03lr78p
        produces-outputs	report_8_1
        updates:
            report_8_1 := report_8_1
    
        element-labels ["AssertionsTest", "Test 8"]
    }
    
