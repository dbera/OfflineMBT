    system AssertionsTestTest2ComposeAndAssert2
    {
        inputs
        Report	report_2_1_2
        
        outputs
        SymbolicParams	params_2_3_1
    
        local
        SymbolicParams	params_2_2_2
    
        context
        UNIT	Event_1dlbjjh
        UNIT	Flow_04tox9b
    
        // init
    
    
        desc "AssertionsTestTest 2Compose And Assert 2_Model"
        
        action			Compose221
        element-label	"Compose 2:2:1"
        case			default priority 2 step-type "null" action-type COMPOSE
        with-inputs		report_2_1_2
        produces-outputs	Flow_04tox9b
        produces-outputs	params_2_2_2
        references {
            result: params_2_2_2.param := report_2_1_2.result
        } symbolic-link
        updates:
            params_2_2_2 := SymbolicParams { id = report_2_1_2.id }
        
        action			Assert222
        element-label	"Assert 2:2:2"
        case			default priority 2 step-type "Assert_2_2_2" action-type ASSERT
        with-inputs		Flow_04tox9b, params_2_2_2
        assertions default {
            result: assert-that (params_2_2_2.param) {
              equal-to params_2_2_2.param
            }
        }
        produces-outputs	Event_1dlbjjh
        updates:
            Event_1dlbjjh := Flow_04tox9b
        produces-outputs	params_2_3_1
        references {
            result: params_2_3_1.param := params_2_2_2.param
        } symbolic-link
        updates:
            params_2_3_1 := SymbolicParams { id = params_2_2_2.id }
    
        element-labels ["AssertionsTest", "Test 2", "Compose And Assert 2"]
    }
    
