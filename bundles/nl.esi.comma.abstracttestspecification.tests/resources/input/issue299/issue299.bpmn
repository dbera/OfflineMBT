        <bpmn4s:raw>@context
record ContextComposeJobB {
  int iteration_index
  JobB job
}

@context
record ContextController {
  int job_index
  Parameters model_parameters
}

record InputJobA {
  int job_id
}

record InputJobB {
  int job_id
  @mixed KeyValuePair[] list_of_key_value_pairs
}

record JobA {
  int job_id
}

record JobB {
  int job_id
  string some_label
  int count
}

record KeyValuePair {
  string key
  @mixed string value
}

record Parameters {
  int job_count
  string job_tag
}

record ReportJobA {
  int job_id
  @symbolic string some_value
}

record ReportJobB {
  int job_id
}

record TempInputJobB {
  int iteration_index
  InputJobB input
}</bpmn4s:raw>
      
