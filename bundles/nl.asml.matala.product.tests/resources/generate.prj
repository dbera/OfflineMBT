Project bpmn4s2pspec {
	Generate Simulator {
		gettest {
			product-file "input/gettest/gettest.ps"
		}
	}
	Generate Simulator {
		imaging {
			product-file "input/imaging/imaging.ps"
		}
	}
	Generate Simulator {
		issue371 {
			bpmn-file "input/issue371/issue371.bpmn"
		}
	}
	Generate Simulator {
		issue426 {
			bpmn-file "input/issue426/issue426.bpmn"
		}
	}
	Generate Simulator {
		printer {
			product-file "input/printer/printer.ps"
		}
	}
}