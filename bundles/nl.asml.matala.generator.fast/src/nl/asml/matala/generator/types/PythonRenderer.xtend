package nl.asml.matala.generator.types

import java.util.ArrayList
import java.util.HashSet
import java.util.LinkedHashMap
import java.util.List
import java.util.Map
import java.util.Set

/** Deterministic Python emission using Xtend rich-string templates. */
final class PythonRenderer {
    public static val Set<String> HELPERS = Set.of("F", "L", "FileSelector", "Ref", "RefList", "Template")
    public static val Set<String> KEYWORDS = Set.of(
        "False",
        "None",
        "True",
        "and",
        "as",
        "assert",
        "async",
        "await",
        "break",
        "class",
        "continue",
        "def",
        "del",
        "elif",
        "else",
        "except",
        "finally",
        "for",
        "from",
        "global",
        "if",
        "import",
        "in",
        "is",
        "lambda",
        "nonlocal",
        "not",
        "or",
        "pass",
        "raise",
        "return",
        "try",
        "while",
        "with",
        "yield"
    )
    public static val Set<String> GLOBALS = Set.of(
        "F",
        "L",
        "FileSelector",
        "Model",
        "Ref",
        "RefList",
        "Template",
        "StrEnum",
        "list",
        "dict",
        "str",
        "int",
        "float",
        "bool",
        "MODEL_SUMMARIES"
    )

    def static String identifier(String name) {
        if (name === null || !name.matches("[A-Za-z][A-Za-z0-9_]*") || KEYWORDS.contains(name))
            throw new IllegalArgumentException("Invalid Python identifier: " + name)
        name
    }

    def String render(Schema schema) {
        val Map<String, Schema.Declaration> types = new LinkedHashMap<String, Schema.Declaration>()
        for (d : schema.declarations()) {
            identifier(d.name())
            if (GLOBALS.contains(d.name()) || types.putIfAbsent(d.name(), d) !== null)
                throw new IllegalArgumentException("Duplicate/reserved type: " + d.name())
        }
        val sections = new ArrayList<String>()
        val emitted = new HashSet<String>()
        for (d : types.values()) {
            if (!d.literals().empty) {
                sections.add(renderEnum(d))
                emitted.add(d.name())
            }
        }
        for (d : types.values()) {
            if (d.base() !== null)
                alias(d, types, emitted, new HashSet<String>(), sections)
        }
        for (d : types.values()) {
            if(record(d)) sections.add(renderRecord(d, types))
        }
        sections.add(renderSummaries(types))
        // Keep the supplied renderer's API and output behavior; no model_rebuild is added.
        '''
            # Generated by typesToPython. Do not edit.
            from __future__ import annotations
            
            from enum import StrEnum
            from .ui_api import F, L, FileSelector, Model, Ref, RefList, Template
            
            
            «sections.join("\n\n")»
        '''.toString
    }

    /** Emit class-object keys after every class has been declared. */
    def private String renderSummaries(Map<String, Schema.Declaration> types) {
        val summaries = types.values().filter [
            record(it) && it.metadata().containsKey("summary")
        ].toList
        if(summaries.empty) return "MODEL_SUMMARIES = {}"
        '''
            MODEL_SUMMARIES = {
                «FOR declaration : summaries»
                    «declaration.name()»: «renderSummary(declaration.metadata().get("summary"))»,
                «ENDFOR»
            }
        '''.toString
    }

    def private String renderSummary(Object value) {
        if (!(value instanceof Map<?, ?>))
            throw new IllegalArgumentException("Summary metadata must be a map")
        val summary = value as Map<?, ?>
        val lines = summary.get("lines")
        if (!(lines instanceof List<?>))
            throw new IllegalArgumentException("Summary lines must be a list")
        '''
            {
                «IF summary.containsKey("title")»
                    "title": «PythonValues.literal(summary.get("title"))»,
                «ENDIF»
                "lines": [
                    «FOR line : lines as List<?>»
                        «PythonValues.literal(line)»,
                    «ENDFOR»
                ],
            }
        '''.toString
    }

    def private String renderEnum(Schema.Declaration d) {
        val seen = new HashSet<String>()
        val members = new ArrayList<String>()
        for (member : d.literals()) {
            identifier(member)
            if (!seen.add(member))
                throw new IllegalArgumentException("Duplicate enum member: " + member)
            val value = d.metadata().getOrDefault("value_" + member, member)
            if (!(value instanceof String))
                throw new IllegalArgumentException("Enum value must be a string")
            members.add('''«member» = «PythonValues.literal(value)»'''.toString)
        }
        '''
            class «d.name()»(StrEnum):
                «FOR member : members»
                    «member»
                «ENDFOR»
        '''.toString
    }

    def private String renderRecord(Schema.Declaration d, Map<String, Schema.Declaration> types) {
        val seen = new HashSet<String>()
        val fields = new ArrayList<String>()
        for (f : d.fields()) {
            identifier(f.name())
            if (!seen.add(f.name()) || GLOBALS.contains(f.name()))
                throw new IllegalArgumentException("Duplicate/reserved field: " + f.name())
            fields.add(renderField(f, types))
        }
        '''
            class «d.name()»(Model):
                «IF fields.empty»
                    pass
                «ELSE»
                    «FOR field : fields»
                        «field»
                    «ENDFOR»
                «ENDIF»
        '''.toString
    }

    def private String renderField(Schema.Field f, Map<String, Schema.Declaration> types) {
        var String pythonType = type(f.type(), types)
        val meta = new LinkedHashMap<String, Object>(f.metadata())
        val helper = if (f.helper() === null) {
                if(pythonType.startsWith("list[")) "L" else "F"
            } else f.helper()
        if (!HELPERS.contains(helper)) {
            throw new IllegalArgumentException("Unsupported helper: " + helper)
        }
        if (Set.of("L", "RefList").contains(helper) && !pythonType.startsWith("list[")) {
            throw new IllegalArgumentException(helper + " requires a list: " + f.name())
        }
        if (Set.of("Ref", "FileSelector", "Template").contains(helper) && pythonType != "str") {
            throw new IllegalArgumentException(helper + " requires string: " + f.name())
        }
        if (meta.containsKey("default") && meta.containsKey("default_factory")) {
            throw new IllegalArgumentException("Conflicting defaults: " + f.name())
        }
        for (key : meta.keySet())
            identifier(key)
        if (meta.containsKey("required") && !(meta.get("required") instanceof Boolean)) {
            throw new IllegalArgumentException("required must be boolean")
        }
        for (key : List.of("filters", "items", "relevant_if", "required_if")) {
            if (meta.containsKey(key) && !(meta.get(key) instanceof Map<?, ?>)) {
                throw new IllegalArgumentException(key + " must be an object")
            }
        }
        if (meta.containsKey("predefined") && !(meta.get("predefined") instanceof List<?>)) {
            throw new IllegalArgumentException("predefined must be a list")
        }
        val low = meta.get("ge")
        val high = meta.get("le")
        if (low instanceof Number) {
            if (high instanceof Number) {
                if (low.doubleValue() > high.doubleValue()) {
                    throw new IllegalArgumentException("ge must not exceed le")
                }
            }
        }
        if (helper == "RefList" && pythonType != "list[str]") {
            throw new IllegalArgumentException("RefList requires string items")
        }
        if (meta.containsKey("default") && meta.get("default") === null) {
            pythonType = pythonType + " | None"
        }

        val arguments = new ArrayList<String>()
        if (helper == "Ref" || helper == "RefList") {
            val path = meta.remove("path")
            if (!(path instanceof String)) {
                throw new IllegalArgumentException("Reference path required: " + f.name())
            }
            if ((path as String).isBlank()) {
                throw new IllegalArgumentException("Reference path required: " + f.name())
            }
            arguments.add(PythonValues.literal(path))
        }
        if (!meta.containsKey("default") && !meta.containsKey("default_factory")) {
            if (Boolean.TRUE.equals(meta.get("required"))) {
                meta.put("default", Required.VALUE)
            } else if (types.containsKey(f.type()) && record(types.get(f.type()))) {
                cycle(f.type(), types, new HashSet<String>())
                meta.put("default_factory", f.type())
            } else if (helper == "F") {
                meta.put("default", scalarDefault(pythonType))
            }
        }
        for (entry : meta.entrySet()) {
            val value = argumentValue(entry.key, entry.value, types)
            arguments.add('''«entry.key»=«value»'''.toString)
        }
        '''
            «f.name()»: «pythonType» = «helper»(
                «FOR argument : arguments»
                    «argument»,
                «ENDFOR»
            )
        '''.toString
    }

    def private Object scalarDefault(String pythonType) {
        switch pythonType {
            case "str": ""
            case "int": 0
            case "float": 0.0
            case "bool": false
            default: Required.VALUE
        }
    }

    def private String argumentValue(String key, Object value, Map<String, Schema.Declaration> types) {
        if (key == "default_factory") {
            val factory = String.valueOf(value)
            if (!Set.of("list", "dict").contains(factory) && !types.containsKey(factory)) {
                throw new IllegalArgumentException("Unknown factory: " + factory)
            }
            return '''lambda: «identifier(factory)»()'''.toString
        }
        if(value === Required.VALUE) "..." else PythonValues.literal(value)
    }

    private enum Required {
        VALUE
    }

    def private static boolean record(Schema.Declaration d) {
        d.base() === null && d.literals().empty
    }

    def private void cycle(String name, Map<String, Schema.Declaration> types, Set<String> visiting) {
        if (!visiting.add(name)) {
            throw new IllegalArgumentException("Recursive default factories: " + name + "; use default_json=\"null\"")
        }
        for (f : types.get(name).fields()) {
            if (types.containsKey(f.type()) && record(types.get(f.type())) && !f.metadata().containsKey("default") &&
                !Boolean.TRUE.equals(f.metadata().get("required")))
                cycle(f.type(), types, visiting)
        }
        visiting.remove(name)
    }

    def private void alias(Schema.Declaration d, Map<String, Schema.Declaration> types, Set<String> emitted,
        Set<String> visiting, List<String> sections) {
        if (!emitted.contains(d.name())) {
            if (!visiting.add(d.name())) {
                throw new IllegalArgumentException("Cyclic alias: " + d.name())
            }
            val target = types.get(d.base())
            if (target !== null && target.base() !== null)
                alias(target, types, emitted, visiting, sections)
            if (target !== null && record(target)) {
                throw new IllegalArgumentException("Record alias unsupported: " + d.name())
            }
            sections.add('''«d.name()» = «type(d.base(), types)»'''.toString)
            visiting.remove(d.name())
            emitted.add(d.name())
        }
    }

    /** Only validated type syntax is emitted; arbitrary source text is never executed. */
    def String type(String source, Map<String, Schema.Declaration> types) {
        val s = source.replaceAll("\\s+", "")
        if (s.endsWith("[]"))
            return '''list[«type(s.substring(0, s.length() - 2), types)»]'''.toString
        if (s.startsWith("map<") && s.endsWith(">")) {
            val body = s.substring(4, s.length() - 1)
            var int depth = 0
            var int i = 0
            while (i < body.length()) {
                val c = body.charAt(i)
                if(c == 60) depth++
                if(c == 62) depth--
                if (c == 44 && depth == 0){
                    return '''dict[«type(body.substring(0, i), types)», «type(body.substring(i + 1), types)»]'''.toString
                }
                i++
            }
            throw new IllegalArgumentException("Invalid map: " + source)
        }
        switch s {
            case "string": "str"
            case "int":    "int"
            case "real":   "float"
            case "bool":   "bool"
            default: {
                if (!types.containsKey(s)) {
                    throw new IllegalArgumentException("Unknown/unsupported type: " + source)
                }
                identifier(s)
            }
        }
    }
}
