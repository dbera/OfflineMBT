package nl.asml.matala.generator.types

import java.util.ArrayList
import java.util.HashSet
import java.util.LinkedHashMap
import java.util.List
import java.util.Map
import java.util.Set

import nl.asml.matala.generator.types.Schema

/** Deterministic Python emission using Xtend rich-string templates. */
final class PythonRenderer {
    public static val Set<String> HELPERS = Set.of("F", "L", "FileSelector", "Ref", "RefList", "Template")
    public static val Set<String> KEYWORDS = Set.of(
        "False",
        "None",
        "True",
        "and",
        "as",
        "assert",
        "async",
        "await",
        "break",
        "class",
        "continue",
        "def",
        "del",
        "elif",
        "else",
        "except",
        "finally",
        "for",
        "from",
        "global",
        "if",
        "import",
        "in",
        "is",
        "lambda",
        "nonlocal",
        "not",
        "or",
        "pass",
        "raise",
        "return",
        "try",
        "while",
        "with",
        "yield"
    )
    // Only names emitted by this module itself remain reserved. Runtime and
    // standard-library symbols are package-qualified and therefore do not
    // collide with user declarations.
    public static val Set<String> GLOBALS = Set.of("MODEL_SUMMARIES")

    def static String identifier(String name) {
        if (name === null || !name.matches("[A-Za-z][A-Za-z0-9_]*") || KEYWORDS.contains(name))
            throw new IllegalArgumentException("Invalid Python identifier: " + name)
        name
    }

    def String render(Schema schema) {
        val Map<String, Schema.Declaration> types = new LinkedHashMap<String, Schema.Declaration>()
        for (d : schema.declarations()) {
            identifier(d.name())
            if (GLOBALS.contains(d.name()) || types.putIfAbsent(d.name(), d) !== null)
                throw new IllegalArgumentException("Duplicate/reserved type: " + d.name())
        }
        val sections = new ArrayList<String>()
        sections.add(PythonSupport.render())
        val emitted = new HashSet<String>()
        for (d : types.values()) {
            if (!d.literals().empty) {
                sections.add(renderEnum(d))
                emitted.add(d.name())
            }
        }
        for (d : types.values()) {
            if (d.base() !== null)
                alias(d, types, emitted, new HashSet<String>(), sections)
        }
        val orderedRecords = new ArrayList<Schema.Declaration>()
        val ordered = new HashSet<String>()
        for (d : types.values()) {
            if(record(d)) orderRecord(d, types, ordered, new HashSet<String>(), orderedRecords)
        }
        for (d : orderedRecords)
            sections.add(renderRecord(d, types))
        sections.add(renderSummaries(types))
        // Keep the supplied renderer's API and output behavior; no model_rebuild is added.
        '''
            # Generated by typesToPython. Do not edit.
            from __future__ import annotations
            
            import builtins as _types_builtins
            import enum as _types_enum
            import typing as _types_typing
            import pydantic as _types_pydantic
            from . import ui_api as _types_ui_api
            from . import model_utils as _types_model_utils
            
            
            «sections.join("\n\n")»
        '''.toString
    }

    /** Emit class-object keys after every class has been declared. */
    def private String renderSummaries(Map<String, Schema.Declaration> types) {
        val summaries = types.values().filter [
            record(it) && it.metadata().containsKey("summary")
        ].toList
        if(summaries.empty) return "MODEL_SUMMARIES = {}"
        '''
            MODEL_SUMMARIES = {
                «FOR declaration : summaries»
                    «declaration.name()»: «renderSummary(declaration.metadata().get("summary"))»,
                «ENDFOR»
            }
        '''.toString
    }

    def private String renderSummary(Object value) {
        if (!(value instanceof Map<?, ?>))
            throw new IllegalArgumentException("Summary metadata must be a map")
        val summary = value as Map<?, ?>
        val lines = summary.get("lines")
        if (!(lines instanceof List<?>))
            throw new IllegalArgumentException("Summary lines must be a list")
        '''
            {
                «IF summary.containsKey("title")»
                    "title": «PythonValues.literal(summary.get("title"))»,
                «ENDIF»
                "lines": [
                    «FOR line : lines as List<?>»
                        «PythonValues.literal(line)»,
                    «ENDFOR»
                ],
            }
        '''.toString
    }

    def private String renderEnum(Schema.Declaration d) {
        val seen = new HashSet<String>()
        val members = new ArrayList<String>()
        for (member : d.literals()) {
            identifier(member)
            if (!seen.add(member))
                throw new IllegalArgumentException("Duplicate enum member: " + member)
            val value = d.metadata().getOrDefault("value_" + member, member)
            if (!(value instanceof String))
                throw new IllegalArgumentException("Enum value must be a string")
            members.add('''«member» = «PythonValues.literal(value)»'''.toString)
        }
        '''
            class «d.name()»(_types_enum.StrEnum):
                «FOR member : members»
                    «member»
                «ENDFOR»
        '''.toString
    }

    def private String renderRecord(Schema.Declaration d, Map<String, Schema.Declaration> types) {
        val seen = new HashSet<String>()
        val fields = new ArrayList<String>()
        for (f : d.fields()) {
            identifier(f.name())
            if (!seen.add(f.name()))
                throw new IllegalArgumentException("Duplicate/reserved field: " + f.name())
            fields.add(renderField(f, types))
        }
        '''
            class «d.name()»(_types_ui_api.Model):
                «IF fields.empty»
                    pass
                «ELSE»
                    «FOR field : fields»
                        «field»
                    «ENDFOR»
                «ENDIF»
        '''.toString
    }

    /** Direct factory symbols must be declared before their owning classes. */
    def private void orderRecord(Schema.Declaration declaration, Map<String, Schema.Declaration> types,
        Set<String> emitted, Set<String> visiting, List<Schema.Declaration> output) {
        if (!emitted.contains(declaration.name())) {
            if (!visiting.add(declaration.name()))
                throw new IllegalArgumentException("Cyclic record default factories: " + declaration.name())
            for (field : declaration.fields()) {
                val meta = field.metadata()
                val dependency = if (meta.containsKey("default_factory"))
                        String.valueOf(meta.get("default_factory"))
                    else if(!meta.containsKey("default") && !meta.containsKey("default_enum") &&
                        !Boolean.TRUE.equals(meta.get("required"))) field.type() else ""
                val target = types.get(dependency)
                if(target !== null && record(target)) orderRecord(target, types, emitted, visiting, output)
            }
            visiting.remove(declaration.name())
            emitted.add(declaration.name())
            output.add(declaration)
        }
    }

    def private String renderField(Schema.Field field, Map<String, Schema.Declaration> types) {
        new PythonFieldRenderer().render(field, types)
    }

    def private static boolean record(Schema.Declaration declaration) {
        declaration.base() === null && declaration.literals().empty
    }

    def private void alias(Schema.Declaration d, Map<String, Schema.Declaration> types, Set<String> emitted,
        Set<String> visiting, List<String> sections) {
        if (!emitted.contains(d.name())) {
            if (!visiting.add(d.name())) {
                throw new IllegalArgumentException("Cyclic alias: " + d.name())
            }
            val target = types.get(d.base())
            if (target !== null && target.base() !== null)
                alias(target, types, emitted, visiting, sections)
            if (target !== null && record(target)) {
                throw new IllegalArgumentException("Record alias unsupported: " + d.name())
            }
            sections.add('''«d.name()» = «type(d.base(), types)»'''.toString)
            visiting.remove(d.name())
            emitted.add(d.name())
        }
    }

    /** Only validated type syntax is emitted; arbitrary source text is never executed. */
    def String type(String source, Map<String, Schema.Declaration> types) {
        val s = source.replaceAll("\\s+", "")
        if (s.endsWith("[]"))
            return '''_types_builtins.list[«type(s.substring(0, s.length() - 2), types)»]'''.toString
        if (s.startsWith("map<") && s.endsWith(">")) {
            val body = s.substring(4, s.length() - 1)
            var int depth = 0
            var int i = 0
            while (i < body.length()) {
                val c = body.charAt(i)
                if(c == 60) depth++
                if(c == 62) depth--
                if (c == 44 && depth == 0) {
                    return '''_types_builtins.dict[«type(body.substring(0, i), types)», «type(body.substring(i + 1), types)»]'''.
                        toString
                }
                i++
            }
            throw new IllegalArgumentException("Invalid map: " + source)
        }
        switch s {
            case "string":
                "_types_builtins.str"
            case "int":
                "_types_builtins.int"
            case "real":
                "_types_builtins.float"
            case "bool":
                "_types_builtins.bool"
            default: {
                if (!types.containsKey(s)) {
                    throw new IllegalArgumentException("Unknown/unsupported type: " + source)
                }
                identifier(s)
            }
        }
    }
}
